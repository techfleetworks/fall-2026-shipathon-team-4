# Copy to .env.local (never committed) and fill in from Supabase → Project Settings → API.
# Full steps: docs/SUPABASE_SETUP.md. Leave everything blank to keep the on-device demo sign-in.

# --- Browser (built into the app; these are PUBLIC by design, protected by Row-Level Security) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (Express API). Never prefix these with VITE_ ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET: only used to delete an account (DELETE /api/account). Keep it out of the browser and out of git.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: "true" makes the API refuse requests if Supabase isn't configured (use in production).
REQUIRE_AUTH=

# --- Plain → clinical mapping engine (server only, ADR-006). Leave both blank: free rules engine. ---
# "claude" turns on the optional AI engine ONLY if ANTHROPIC_API_KEY is also set (paid; the rules engine stays as fallback).
MAPPING_ENGINE=
# SECRET, paid. Never prefix with VITE_. Not needed for the free default.
ANTHROPIC_API_KEY=

# --- Which site this build is (ADR-016, docs/VERCEL_SITES.md). Leave empty on your computer. ---
# Real users' site: VITE_SITE_MODE=live and VITE_DEMO_URL=https://fall-2026-shipathon-team-4-rosy.vercel.app
# Demo site:        VITE_SITE_MODE=demo, VITE_DEMO_LOGIN_EMAIL=theo.demo@example.com, VITE_DEMO_LOGIN_PASSWORD=<shown publicly>
VITE_SITE_MODE=
VITE_DEMO_URL=
VITE_DEMO_LOGIN_EMAIL=
VITE_DEMO_LOGIN_PASSWORD=

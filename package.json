{
  "name": "get-heard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "dev:api:supabase": "node --env-file=.env.local --import tsx server/dev.ts",
    "dev:api:demo": "node --env-file=.env.demo-server.local --import tsx server/dev.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "npm run test:unit && npm run test:bdd",
    "test:unit": "vitest run",
    "test:bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js",
    "eval:mapping": "node --import tsx scripts/eval-mapping.ts",
    "seed:theo": "node --env-file=.env.demo-server.local --import tsx scripts/seed-theo.ts",
    "seed:theo:demo": "node --env-file=.env.demo-server.local --import tsx scripts/seed-theo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@supabase/supabase-js": "2.119.0",
    "express": "5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
